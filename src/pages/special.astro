---
import Logo from "../components/Logo.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Powered by · Ryan William Snow" description="Powered by Astro. Hand designed in Figma. Clanker coded with Cursor. Haiku by Issa.">
	<div class="special">
		<video class="special-photo" src={`${base}special.mp4`} autoplay muted loop playsinline></video>
		<div class="special-caption">
			<Logo />
			<div class="special-notes">
				<p>
					Powered by <a href="https://astro.build" target="_blank" rel="noreferrer">astro</a>
				</p>
				<p>Hand designed in Figma</p>
				<p>Clanker coded with Cursor</p>
				<p>Haiku by Issa</p>
				<p><a class="special-close" href="/">close</a></p>
			</div>
		</div>
	</div>
</BaseLayout>

<script>
	const closeLink = document.querySelector<HTMLAnchorElement>(".special-close");
	const ref = document.referrer;

	if (closeLink && ref) {
		try {
			const url = new URL(ref);
			if (url.origin === location.origin && url.pathname !== location.pathname) {
				closeLink.href = `${url.pathname}${url.search}`;
			}
		} catch {
			/* Keep the home link when the referrer is not a usable URL. */
		}
	}
</script>
