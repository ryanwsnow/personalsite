---
interface Props {
	company: string;
	href?: string;
	role: string;
	summary: string;
	tags: string[];
}

const { company, href, role, summary, tags } = Astro.props;
const icon = `${import.meta.env.BASE_URL}icon-open.svg`;
---

<article class="role">
	<header class="role-header">
		<h3 class="role-title">
			{
				href ? (
					<a href={href} target="_blank" rel="noreferrer">
						{company}
					</a>
				) : (
					<span>{company}</span>
				)
			}
			<img src={icon} width="16" height="16" alt="" />
		</h3>
		<p class="role-meta">{role}</p>
	</header>
	<p class="role-summary">{summary}</p>
	<ul class="tags">
		{tags.map((tag) => <li>{tag}</li>)}
	</ul>
</article>
