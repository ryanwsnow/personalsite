			<path
				d="M12.1 22C10.7 22 9.3875 21.7333 8.1625 21.2C6.9375 20.6667 5.87083 19.9458 4.9625 19.0375C4.05417 18.1292 3.33333 17.0625 2.8 15.8375C2.26667 14.6125 2 13.3 2 11.9C2 9.46667 2.775 7.32083 4.325 5.4625C5.875 3.60417 7.85 2.45 10.25 2C9.95 3.65 10.0417 5.2625 10.525 6.8375C11.0083 8.4125 11.8417 9.79167 13.025 10.975C14.2083 12.1583 15.5875 12.9917 17.1625 13.475C18.7375 13.9583 20.35 14.05 22 13.75C21.5667 16.15 20.4167 18.125 18.55 19.675C16.6833 21.225 14.5333 22 12.1 22ZM12.1 20C13.5667 20 14.925 19.6333 16.175 18.9C17.425 18.1667 18.4083 17.1583 19.125 15.875C17.6917 15.7417 16.3333 15.3792 15.05 14.7875C13.7667 14.1958 12.6167 13.3917 11.6 12.375C10.5833 11.3583 9.775 10.2083 9.175 8.925C8.575 7.64167 8.21667 6.28333 8.1 4.85C6.81667 5.56667 5.8125 6.55417 5.0875 7.8125C4.3625 9.07083 4 10.4333 4 11.9C4 14.15 4.7875 16.0625 6.3625 17.6375C7.9375 19.2125 9.85 20 12.1 20Z"
				fill="currentColor"></path>
		</svg>
	</button>
	<button class="theme-option" type="button" data-theme-value="light" aria-pressed="false" aria-label="Light theme">
		<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
			<path
				d="M11.0002 5V1H13.0002V5H11.0002ZM17.6502 7.75L16.2752 6.375L19.0752 3.5L20.4752 4.925L17.6502 7.75ZM19.0002 13V11H23.0002V13H19.0002ZM11.0002 23V19H13.0002V23H11.0002ZM6.35018 7.7L3.50018 4.925L4.92518 3.525L7.75018 6.35L6.35018 7.7ZM19.0502 20.5L16.2752 17.625L17.6252 16.275L20.4752 19.025L19.0502 20.5ZM1.00018 13V11H5.00018V13H1.00018ZM4.92518 20.5L3.52518 19.075L6.32518 16.275L7.05018 16.95L7.77518 17.65L4.92518 20.5ZM7.75018 16.25C6.58352 15.0833 6.00018 13.6667 6.00018 12C6.00018 10.3333 6.58352 8.91667 7.75018 7.75C8.91685 6.58333 10.3335 6 12.0002 6C13.6669 6 15.0835 6.58333 16.2502 7.75C17.4168 8.91667 18.0002 10.3333 18.0002 12C18.0002 13.6667 17.4168 15.0833 16.2502 16.25C15.0835 17.4167 13.6669 18 12.0002 18C10.3335 18 8.91685 17.4167 7.75018 16.25ZM14.8252 14.825C15.6085 14.0417 16.0002 13.1 16.0002 12C16.0002 10.9 15.6085 9.95833 14.8252 9.175C14.0418 8.39167 13.1002 8 12.0002 8C10.9002 8 9.95852 8.39167 9.17518 9.175C8.39185 9.95833 8.00018 10.9 8.00018 12C8.00018 13.1 8.39185 14.0417 9.17518 14.825C9.95852 15.6083 10.9002 16 12.0002 16C13.1002 16 14.0418 15.6083 14.8252 14.825Z"
				fill="currentColor"></path>
		</svg>
	</button>
</div>

<script>
	const root = document.documentElement;
	const options = document.querySelectorAll<HTMLButtonElement>("[data-theme-value]");
	let fadeTimer: number | undefined;

	function applyTheme(theme: string) {
		const next = theme === "light" ? "light" : "dark";
		const changing = root.dataset.theme !== next;
		const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		if (changing && !reduceMotion) {
			root.classList.add("theme-fade");
			void root.offsetWidth;
			window.clearTimeout(fadeTimer);
			fadeTimer = window.setTimeout(() => root.classList.remove("theme-fade"), 320);
		}

		root.dataset.theme = next;
		localStorage.setItem("theme", next);
		options.forEach((option) => {
			option.setAttribute("aria-pressed", String(option.dataset.themeValue === next));
		});
	}

	options.forEach((option) => {
		option.addEventListener("click", () => {
			const theme = option.dataset.themeValue;
			if (theme) applyTheme(theme);
		});
	});

	applyTheme(root.dataset.theme === "light" ? "light" : "dark");
</script>
