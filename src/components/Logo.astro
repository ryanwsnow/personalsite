---
interface Props {
	href?: string;
}

const { href } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag class="logo" href={href}>
	<svg class="logo-bug" width="157" height="67" viewBox="0 42.509 157.107 67.071" fill="none" role="img" aria-label="Hazzini">
		<path d="M68.7725 73.1272L42.0285 46.3829L34.387 99.8734L3.82098 76.9507M68.7725 73.1272L68.7737 46.3829M68.7725 73.1272L68.7725 92.2319L98.1644 83.0755M98.1644 83.0755C109.348 63.7054 109.437 63.6691 118.851 46.3302L153.287 65.4433L98.1644 83.0755ZM98.1644 83.0755C96.5627 85.8497 86.8885 102.633 85.0831 105.76" stroke="currentColor" stroke-width="7.6415" stroke-linecap="round" stroke-linejoin="round" />
	</svg>
	<span class="logo-highlight" aria-hidden="true">
		<svg viewBox="0 130.27 157.107 25.773" fill="none" preserveAspectRatio="none"><path d="M4.8933 131.156L4.8933 155.156" /></svg>
		<svg viewBox="0 130.27 157.107 25.773" fill="none" preserveAspectRatio="none"><path d="M19.5144 131.156L19.5144 155.156" /></svg>
		<svg viewBox="0 130.27 157.107 25.773" fill="none" preserveAspectRatio="none"><path d="M34.071 131.156L34.071 155.156" /></svg>
		<svg viewBox="0 130.27 157.107 25.773" fill="none" preserveAspectRatio="none"><path d="M57.6042 131.156L47.9005 155.156" /></svg>
		<svg viewBox="0 130.27 157.107 25.773" fill="none" preserveAspectRatio="none"><path d="M84.4642 133.954L65.1847 155.156" /></svg>
		<svg viewBox="0 130.27 157.107 25.773" fill="none" preserveAspectRatio="none"><path d="M97.4289 131.156L97.4289 155.156" /></svg>
		<svg viewBox="0 130.27 157.107 25.773" fill="none" preserveAspectRatio="none"><path d="M108.969 132.279L118.605 155.156" /></svg>
		<svg viewBox="0 130.27 157.107 25.773" fill="none" preserveAspectRatio="none"><path d="M124.185 134.751L137.177 155.156" /></svg>
		<svg viewBox="0 130.27 157.107 25.773" fill="none" preserveAspectRatio="none"><path d="M151.04 131.156L151.04 155.156" /></svg>
	</span>
</Tag>

<script>
	let settle;

	function onScroll() {
		document.documentElement.classList.add("is-scrolling");
		clearTimeout(settle);
		settle = setTimeout(() => {
			document.documentElement.classList.remove("is-scrolling");
		}, 160);
	}

	window.addEventListener("scroll", onScroll, { passive: true });
</script>
